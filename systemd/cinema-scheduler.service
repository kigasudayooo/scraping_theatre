[Unit]
Description=Cinema Scraping Scheduler
After=network.target

[Service]
Type=simple
User=argon
WorkingDirectory=/home/argon/dev/scraping_theatre
Environment=PATH=/home/argon/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/uv run python src/scheduler/cinema_scheduler.py
Restart=always
RestartSec=10

# ログ設定
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cinema-scheduler

# セキュリティ設定
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/home/argon/dev/scraping_theatre

[Install]
WantedBy=multi-user.target